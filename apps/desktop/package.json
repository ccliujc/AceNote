{
  "name": "@acenote/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run rebuild && electron-vite dev",
    "start": "npm run rebuild && electron .",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json",
